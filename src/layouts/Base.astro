---
import { defaultLang, langs, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path?: string; // page path after the language, e.g. "test"
  title: string; // full <title>, shown in search results
  description: string;
  jsonLd?: Record<string, unknown>[]; // extra schema.org blocks for this page
  noindex?: boolean; // e.g. the 404 page: no canonical, hreflang or search indexing
}
const { lang, path = '', title, description, jsonLd = [], noindex = false } = Astro.props;
const s = ui[lang];

const urlOf = (l: Lang) => new URL(`/${l}${path ? `/${path}` : ''}`, Astro.site).href;
const url = urlOf(lang);
const ogImage = new URL(`/og-${lang}.png`, Astro.site).href;
const locales: Record<Lang, string> = { ru: 'ru_RU', en: 'en_US' };
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: s.siteName,
  url: new URL(`/${lang}`, Astro.site).href,
  inLanguage: lang,
  description: s.seoHomeDesc,
};
const structured = path ? jsonLd : [website, ...jsonLd];

// Main sections; a topic page (topics/…) highlights "Topics".
const section = path.split('/')[0];
const nav = [
  { id: 'topics', label: s.topicsTitle },
  { id: 'test', label: s.introTitle },
  { id: 'test-a2', label: s.introTitleA2 },
  { id: 'exam-a2', label: s.navExam },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={url} />
        {langs.map((l) => <link rel="alternate" hreflang={l} href={urlOf(l)} />)}
        <link rel="alternate" hreflang="x-default" href={urlOf(defaultLang)} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locales[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={locales[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {structured.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <header class="top">
      <a class="brand" href={`/${lang}`}>
        <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="var(--accent)" />
          <rect x="7" y="17" width="5" height="8" rx="1.5" fill="#fff" />
          <rect x="13.5" y="12" width="5" height="13" rx="1.5" fill="#fff" />
          <rect x="20" y="7" width="5" height="18" rx="1.5" fill="#fff" fill-opacity=".45" />
        </svg>
        {s.siteName}
      </a>
      <nav class="main-nav" aria-label="Main">
        {nav.map((n) => (
          <a href={`/${lang}/${n.id}`} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <nav class="lang-nav" aria-label="Language">
        {langs.map((l) => (
          <a href={noindex ? `/${l}` : `/${l}${path ? `/${path}` : ''}`} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="foot-row">
        <a class="brand" href={`/${lang}`}>{s.siteName}</a>
        <nav class="foot-links" aria-label="Footer">
          <a href={`/${lang}/topics`}>{s.topicsTitle}</a>
          <a href={`/${lang}/test`}>{s.introTitle}</a>
          <a href={`/${lang}/test-a2`}>{s.introTitleA2}</a>
          <a href={`/${lang}/exam-a2`}>{s.navExam}</a>
        </nav>
      </div>
      <p class="muted">© {new Date().getFullYear()} {s.siteName}<br />{s.disclaimer}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f8fa;
    --fg: #1c2333;
    --card: #ffffff;
    --accent: #0072ce;
    --ok: #2b8a3e;
    --bad: #c92a2a;
    --muted: #6b7280;
    --line: #dfe3ea;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12151c;
      --fg: #e8ebf2;
      --card: #1b2030;
      --accent: #3a93e0;
      --ok: #51cf66;
      --bad: #ff6b6b;
      --muted: #9aa3b5;
      --line: #2b3245;
    }
  }
  * { box-sizing: border-box; }
  .foot { max-width: 920px; margin: 0 auto; padding: 24px 16px 32px; border-top: 1px solid var(--line); font-size: .875rem; }
  .foot-row { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .foot a { color: var(--fg); text-decoration: none; }
  .foot-links { display: flex; flex-direction: column; gap: 6px; }
  .foot-links a:hover { color: var(--accent); }
  .foot p { margin: 16px 0 0; font-size: .8rem; }
  body {
    margin: 0;
    font: 16px/1.5 system-ui, sans-serif;
    background: var(--bg);
    color: var(--fg);
  }
  /* Keep the footer at the bottom of the screen on short pages. */
  body { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; }
  main { flex: 1 0 auto; width: 100%; }
  .top, .foot { width: 100%; }
  main { max-width: 920px; margin: 0 auto; padding: 0 16px 48px; }
  .top {
    max-width: 920px; margin: 0 auto 24px; padding: 14px 16px;
    display: flex; align-items: center; gap: 12px 24px; flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
  }
  .top a { color: var(--fg); text-decoration: none; }
  .brand { font-weight: 700; display: inline-flex; align-items: center; gap: 10px; }
  .logo { width: 28px; height: 28px; flex: none; }
  .main-nav { display: flex; gap: 4px 20px; flex-wrap: wrap; font-size: .95rem; }
  .main-nav a { padding: 4px 0; border-bottom: 2px solid transparent; }
  .main-nav a:hover { color: var(--accent); }
  .main-nav a[aria-current] { color: var(--accent); border-bottom-color: var(--accent); }
  .lang-nav { display: flex; gap: 8px; margin-left: auto; }
  .lang-nav a { padding: 4px 10px; border: 1px solid var(--line); border-radius: 10px; font-size: .875rem; }
  .lang-nav a[aria-current] { border-color: var(--accent); color: var(--accent); }
  /* Phones: brand and language on the first line, sections on the second. */
  @media (max-width: 640px) {
    .main-nav { order: 3; width: 100%; gap: 4px 16px; font-size: .9rem; }
  }

  .card {
    max-width: 640px; margin: 0 auto; padding: 24px;
    border: 1px solid var(--line); border-radius: 16px; background: var(--card);
  }
  .btn {
    padding: 10px 20px; border: 0; border-radius: 10px; font: inherit;
    background: var(--accent); color: #fff; cursor: pointer;
    display: inline-block; text-decoration: none;
  }
  .btn { transition: background-color .15s, transform .15s, box-shadow .15s; }
  .btn:not(:disabled):hover {
    background: color-mix(in srgb, var(--accent) 85%, #000);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .btn:not(:disabled):active { transform: translateY(0); box-shadow: none; }
  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } .btn:not(:disabled):hover { transform: none; } }
  .btn:disabled { opacity: .4; cursor: not-allowed; }
  .options { display: grid; gap: 8px; margin: 16px 0; }
  .opt {
    width: 100%; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px;
    background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer;
  }
  .opt { transition: border-color .15s, background-color .15s; }
  .opt:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .opt[aria-pressed='true'] { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent) inset; }
  .field {
    width: 100%; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px;
    background: transparent; color: inherit; font: inherit; margin: 16px 0;
  }
  .field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent) inset; }
  .gap { margin: 16px 0; }
  .prompt { font-size: 1.35rem; margin-top: 16px; }
  .muted { color: var(--muted); }
  progress { width: 100%; height: 8px; accent-color: var(--accent); }
  .level { font-size: 3rem; font-weight: 700; color: var(--accent); }
  .rev { padding: 8px 0; border-top: 1px solid var(--line); }
  .ok { color: var(--ok); }
  .bad { color: var(--bad); }
  [hidden] { display: none !important; }
</style>
