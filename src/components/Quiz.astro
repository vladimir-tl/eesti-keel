---
import { ui, type Lang } from '../i18n/ui';
import type { Question } from '../data/questions';
import { t } from '../data/questions';

interface Props {
  lang: Lang;
  title: string;
  intro: string;
  questions: Question[];
  verdicts: readonly { min: number; text: string }[];
  backHref?: string;
  backLabel?: string;
  perGroup?: number;
  hint?: string[];
  placement?: Placement;
}
/** Level test: questions go from A1 to B1, and the result names a level and the topics to review. */
export interface Placement {
  perLevel: number; // questions drawn per level, one per topic
  pass: number; // share of right answers that counts a level as passed
  /** Outcome by the number of levels passed in a row: 0 — not yet A1, 1 — A1, 2 — A2, 3 — B1. */
  outcomes: { level: string; text: string; links: { href: string; label: string }[] }[];
  topics: Record<string, { href: string; title: string }>; // topic id → its page, for "what to review"
}
const { lang, title, intro, questions, verdicts, backHref, backLabel, perGroup = 0, hint, placement } = Astro.props;
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const hintHtml = (hint ?? []).map((l) => `<p>${esc(l).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}</p>`).join('');
const s = ui[lang];

const config = {
  ui: s,
  verdicts,
  perGroup,
  placement: placement ?? null,
  questions: questions.map((q) => ({
    level: q.level,
    prompt: t(q.prompt, lang),
    options: q.options.map((o) => t(o, lang)),
    answer: q.answer,
    accept: q.accept ?? [],
    explain: t(q.explain, lang),
    audio: q.audio ?? '',
    image: q.image ?? '',
    pics: q.pics ?? [],
    group: (q as Question & { group?: string }).group ?? '',
  })),
};
const letters = ['ä', 'ö', 'õ', 'ü', 'š', 'ž'];
---
<div class="card" id="app" data-config={JSON.stringify(config)}>
  <section id="intro">
    <h1>{title}</h1>
    <p class="muted">{intro}</p>
    <div class="row">
      <button class="btn" id="start">{s.start}</button>
      {backHref && <a class="muted" href={backHref}>{backLabel}</a>}
    </div>
  </section>

  <section id="loader" hidden aria-live="polite">
    <div class="deck" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="muted">{s.shuffling}</p>
  </section>

  <section id="quiz" hidden>
    <progress id="bar" value="0" max="1"></progress>
    <div class="muted" id="counter"></div>
    <div class="player" id="player" hidden>
      <audio id="audio" controls preload="none"></audio>
      <button type="button" class="letter" id="slow" aria-pressed="false">🐢 {s.slower}</button>
    </div>
    <div class="pic-box" id="pic" hidden></div>
    <p class="prompt" id="prompt"></p>
    <p class="muted drag-hint" id="dragHint" hidden>{s.dragHint}</p>
    <div class="options" id="options"></div>
    <div id="typing" hidden>
      <input class="field" id="text" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={s.inputPlaceholder} />
      <div class="letters muted">
        {s.typeHint}
        {letters.map((c) => <button type="button" class="letter">{c}</button>)}
      </div>
    </div>
    <div class="feedback" id="feedback" aria-live="polite" hidden></div>
    <div class="row">
      <button class="btn" id="next" disabled>{s.next}</button>
      {placement && <button type="button" class="link-btn" id="skip">{s.dontKnow}</button>}
    </div>
  </section>

  {hint && (
    <details class="hint" id="hint">
      <summary>{s.hint}</summary>
      <div class="hint-body" set:html={hintHtml} />
    </details>
  )}

  <section id="result" hidden>
    <div class="muted">{s.resultTitle}</div>
    <div class="level" id="score"></div>
    <p id="verdict"></p>
    {placement && (
      <div class="place">
        <div class="levels" id="levels"></div>
        <div class="next-links row" id="nextLinks"></div>
        <div id="weak" hidden>
          <h2>{s.placeWeak}</h2>
          <ul class="weak" id="weakList"></ul>
        </div>
      </div>
    )}
    <h2>{s.review}</h2>
    <div id="review"></div>
    <div class="row gap">
      <button class="btn" id="retry">{s.retry}</button>
      {backHref && <a class="muted" href={backHref}>{backLabel}</a>}
    </div>
  </section>
</div>

<style>
  .row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .row a { text-decoration: none; }
  .letters { display: flex; gap: 6px; align-items: center; margin-bottom: 16px; font-size: .875rem; }
  .hint { margin: 16px 0 0; border: 1px solid var(--line); border-radius: 10px; }
  .hint summary { padding: 10px 14px; cursor: pointer; color: var(--accent); font-size: .9rem; }
  .hint summary:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); border-radius: 10px; }
  .hint-body { padding: 0 14px 4px; font-size: .9rem; }
  .hint-body :global(p) { margin: 0 0 10px; line-height: 1.5; }
  #loader { text-align: center; padding: 32px 0; }
  .deck { position: relative; width: 120px; height: 84px; margin: 0 auto 16px; }
  .deck i {
    position: absolute; left: 50%; top: 0; width: 64px; height: 84px; margin-left: -32px;
    border: 2px solid var(--accent); border-radius: 10px; background: var(--card);
    animation: shuffle 1s ease-in-out infinite;
  }
  .deck i:nth-child(2) { animation-delay: .15s; }
  .deck i:nth-child(3) { animation-delay: .3s; }
  @keyframes shuffle {
    0%, 100% { transform: translateX(0) rotate(0); }
    25% { transform: translateX(-44px) rotate(-14deg); z-index: 1; }
    50% { transform: translateX(0) rotate(0); }
    75% { transform: translateX(44px) rotate(14deg); z-index: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .deck i { animation-duration: 2.4s; } }
  :global(.options .opt:disabled) { cursor: default; }
  :global(.options .opt:disabled:hover) { border-color: var(--line); background: transparent; }
  :global(.options .opt.is-right), :global(.options .opt.is-right:hover) {
    border-color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent);
    box-shadow: 0 0 0 2px var(--ok) inset;
  }
  :global(.options .opt.is-wrong), :global(.options .opt.is-wrong:hover) {
    border-color: var(--bad); background: color-mix(in srgb, var(--bad) 10%, transparent);
    box-shadow: 0 0 0 2px var(--bad) inset;
  }
  :global(.options .opt.is-right::after) { content: ' ✓'; color: var(--ok); }
  :global(.options .opt.is-wrong::after) { content: ' ✗'; color: var(--bad); }
  .player { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; }
  #audio { flex: 1; min-width: 0; }
  #slow[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }
  .drag-hint { font-size: .85rem; margin: 8px 0 0; }
  :global(.options.bank) { display: flex; flex-wrap: wrap; gap: 8px; }
  :global(.options.bank .opt) { width: auto; touch-action: none; user-select: none; cursor: grab; }
  :global(.options.bank .opt.is-away) { opacity: .35; }
  :global(.blank) {
    display: inline-block; min-width: 5.5em; padding: 0 10px; margin: 0 2px;
    border-bottom: 2px dashed var(--accent); border-radius: 6px 6px 0 0;
    text-align: center; transition: background-color .15s;
  }
  :global(.blank:empty::before) { content: '\00a0'; }
  :global(.blank.over) { background: color-mix(in srgb, var(--accent) 15%, transparent); }
  :global(.blank.is-right) { border-bottom: 2px solid var(--ok); color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
  :global(.blank.is-wrong) { border-bottom: 2px solid var(--bad); color: var(--bad); background: color-mix(in srgb, var(--bad) 10%, transparent); }
  :global(.drag-ghost) {
    position: fixed; z-index: 10; pointer-events: none; margin: 0; width: auto;
    background: var(--card); box-shadow: 0 6px 18px rgba(0, 0, 0, .2); transform: rotate(-2deg);
  }
  #text.is-right { border-color: var(--ok); box-shadow: 0 0 0 2px var(--ok) inset; }
  #text.is-wrong { border-color: var(--bad); box-shadow: 0 0 0 2px var(--bad) inset; }
  .feedback { margin: 0 0 16px; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--line); font-size: .95rem; }
  .feedback :global(p) { margin: 4px 0 0; }
  .link-btn {
    padding: 0; border: 0; background: none; color: var(--muted); font: inherit; cursor: pointer;
    text-decoration: underline; text-underline-offset: 3px;
  }
  .link-btn:hover { color: var(--accent); }
  .link-btn:disabled { visibility: hidden; }
  .place { margin: 8px 0 24px; }
  .levels { display: grid; gap: 10px; margin: 16px 0 20px; }
  :global(.lv) { display: grid; grid-template-columns: 2.5em 1fr 3.5em; align-items: center; gap: 12px; }
  :global(.lv b) { font-size: 1.05rem; }
  :global(.lv .track) { height: 10px; border-radius: 5px; background: var(--line); overflow: hidden; }
  :global(.lv .fill) { height: 100%; border-radius: 5px; background: var(--bad); }
  :global(.lv.pass .fill) { background: var(--ok); }
  :global(.lv span:last-child) { text-align: right; font-variant-numeric: tabular-nums; }
  .next-links { margin-bottom: 8px; }
  :global(.next-links .btn:not(:first-child)) {
    background: transparent; color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent);
  }
  .weak { margin: 0 0 8px; padding-left: 1.2em; line-height: 1.8; }
  :global(.weak a) { color: var(--accent); text-underline-offset: 3px; }
  /* Picture questions: one picture above the prompt, or a grid of picture options. */
  .pic-box { display: flex; justify-content: center; margin: 12px 0 0; }
  :global(.pic-box.small) { justify-content: flex-start; margin: 6px 0; zoom: .6; }
  :global(.options.pics) { grid-template-columns: repeat(2, 1fr); }
  :global(.options.pics .opt) {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 6px; min-height: 120px; text-align: center;
  }
  :global(.options.pics .cap) { visibility: hidden; font-size: .9rem; }
  :global(.options.pics.done .cap) { visibility: visible; }
  :global(.options.pics .opt::after) { position: absolute; top: 6px; right: 10px; }
  :global(.pic-emoji) { font-size: 3.2rem; line-height: 1.25; text-align: center; max-width: 100%; overflow-wrap: anywhere; }
  :global(.pic-clock) { width: 128px; height: 128px; color: var(--fg); }
  :global(.options.pics .pic-clock) { width: 96px; height: 96px; }
  :global(.pic-swatch) { width: 72px; height: 72px; border-radius: 12px; border: 1px solid var(--line); }
  :global(.pic-price span) {
    display: inline-block; padding: 10px 18px 10px 28px; border-radius: 6px 14px 14px 6px;
    background: #ffe066; color: #1c2333; font-size: 1.6rem; font-weight: 700;
    clip-path: polygon(14px 0, 100% 0, 100% 100%, 14px 100%, 0 50%);
  }
  :global(.sign) {
    display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px 24px;
    border: 3px solid #1c2333; border-radius: 8px; background: #fff; color: #1c2333; text-align: center;
  }
  :global(.sign b) { font-size: 1.6rem; letter-spacing: .06em; }
  :global(.sign span) { font-size: 1.05rem; font-weight: 600; }
  :global(.sign-red) { border-color: #c92a2a; color: #c92a2a; }
  :global(.sign-green) { border-color: #2b8a3e; background: #2b8a3e; color: #fff; }
  :global(.sign-blue) { border-color: #0b5cad; background: #0b5cad; color: #fff; }
  :global(.board) { min-width: 220px; max-width: 100%; border: 2px solid var(--line); border-radius: 10px; overflow: hidden; }
  :global(.board-title) { padding: 8px 14px; background: var(--accent); color: #fff; font-weight: 700; }
  :global(.board table) { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  :global(.board th), :global(.board td) { padding: 6px 14px; text-align: left; border-top: 1px solid var(--line); }
  :global(.board td:last-child), :global(.board th:last-child) { text-align: right; }
  :global(.cal) { width: 132px; border: 2px solid var(--line); border-radius: 10px; overflow: hidden; text-align: center; background: #fff; color: #1c2333; }
  :global(.cal-top) { padding: 6px; background: #c92a2a; color: #fff; font-weight: 700; letter-spacing: .05em; }
  :global(.cal-day) { font-size: 3rem; font-weight: 700; line-height: 1.2; }
  :global(.cal-month) { padding: 0 0 8px; font-weight: 600; letter-spacing: .05em; }
  :global(.tree) { display: flex; flex-direction: column; align-items: center; }
  :global(.tree-row) { display: flex; align-items: center; gap: 4px; }
  :global(.tree-row i) { width: 18px; border-top: 2px solid var(--muted); }
  :global(.tree-person) { display: flex; flex-direction: column; align-items: center; min-width: 64px; font-size: .9rem; }
  :global(.tree-person span) { font-size: 2rem; line-height: 1.2; }
  :global(.tree-line) { width: 2px; height: 14px; background: var(--muted); }
  .letter {
    padding: 2px 10px; border: 1px solid var(--line); border-radius: 8px;
    background: transparent; color: var(--fg); font: inherit; cursor: pointer;
  }
</style>

<script>
  interface Q { level: string; prompt: string; options: string[]; answer: number; accept: string[]; explain: string; audio: string; image: string; pics: string[]; group: string }
  interface Placement {
    perLevel: number;
    pass: number;
    outcomes: { level: string; text: string; links: { href: string; label: string }[] }[];
    topics: Record<string, { href: string; title: string }>;
  }
  type Ans = number | string | null;

  const root = document.getElementById('app')!;
  const cfg = JSON.parse(root.dataset.config!) as {
    ui: Record<string, any>;
    verdicts: { min: number; text: string }[];
    questions: Q[];
    perGroup: number;
    placement: Placement | null;
  };
  const LEVELS = ['A1', 'A2', 'B1'];
  // Analytics events (the helper is defined in Base.astro and sends only after consent).
  const track = (name: string, params: Record<string, unknown>) => (window as any).track?.(name, params);
  const quizId = location.pathname.split('/').filter(Boolean).slice(1).join('/') || 'home';
  // "I don't know" in the level test: counts as a wrong answer.
  const SKIPPED = -2;
  const { ui } = cfg;
  let questions: Q[] = cfg.questions;

  // Fisher–Yates shuffle, so every attempt has a new question order
  const shuffled = <T,>(list: T[]): T[] => {
    const a = [...list];
    for (let k = a.length - 1; k > 0; k--) {
      const j = Math.floor(Math.random() * (k + 1));
      [a[k], a[j]] = [a[j], a[k]];
    }
    return a;
  };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (name: 'intro' | 'loader' | 'quiz' | 'result') => {
    (['intro', 'loader', 'quiz', 'result'] as const).forEach((n) => ($(n).hidden = n !== name));
    const hint = document.getElementById('hint');
    if (hint) hint.hidden = name === 'loader' || name === 'result';
    // Text under the quiz marked data-quiz-hide steps aside while the questions are on screen.
    document.querySelectorAll<HTMLElement>('[data-quiz-hide]').forEach((el) => (el.hidden = name === 'loader' || name === 'quiz'));
  };

  const norm = (v: string) =>
    v
      .toLowerCase()
      .replace(/[’‘`´ʼ]/g, "'")
      .replace(/\s+/g, ' ')
      .trim()
      .replace(/[.!]+$/, '')
      .trim();

  const isCorrect = (q: Q, a: Ans) =>
    q.answer >= 0 ? a === q.answer : typeof a === 'string' && q.accept.some((x) => norm(x) === norm(a));

  let i = 0;
  let answers: Ans[] = [];
  let checked: boolean[] = [];

  const setNext = () => {
    const a = answers[i];
    const next = $<HTMLButtonElement>('next');
    next.disabled = a === null || (typeof a === 'string' && !a.trim());
    next.textContent = !checked[i] ? ui.check : i === questions.length - 1 ? ui.finish : ui.next;
    const skip = document.getElementById('skip') as HTMLButtonElement | null;
    if (skip) skip.disabled = checked[i];
  };

  // Right after answering: colour the chosen option / field, reveal the right answer and the explanation.
  function showFeedback() {
    const q = questions[i];
    const ok = isCorrect(q, answers[i]);
    // "I don't know" is not a mistake: just show the right answer, without the red marks.
    const skipped = answers[i] === SKIPPED;
    const bad = !ok && !skipped;
    const fb = $('feedback');
    fb.hidden = !checked[i];
    if (!checked[i]) return;
    if (q.options.length) {
      $('options').classList.add('done');
      const gap = $('prompt').querySelector('.blank');
      gap?.classList.toggle('is-right', ok);
      gap?.classList.toggle('is-wrong', bad);
      $('options').querySelectorAll<HTMLButtonElement>('.opt').forEach((el, k) => {
        el.classList.remove('is-away');
        el.disabled = true;
        el.classList.toggle('is-right', k === q.answer);
        el.classList.toggle('is-wrong', k === answers[i] && !ok);
      });
    } else {
      const text = $<HTMLInputElement>('text');
      text.readOnly = true;
      text.classList.toggle('is-right', ok);
      text.classList.toggle('is-wrong', bad);
    }
    const head = document.createElement('strong');
    const right = q.answer >= 0 ? q.options[q.answer] : q.accept[0];
    head.className = ok ? 'ok' : skipped ? '' : 'bad';
    head.textContent = ok ? `✓ ${ui.rightNow}` : skipped ? `${ui.answerIs} ${right}` : `✗ ${ui.wrongNow} ${right}`;
    const ex = document.createElement('p');
    ex.className = 'muted';
    ex.textContent = q.explain;
    fb.replaceChildren(head, ex);
  }

  function check() {
    checked[i] = true;
    showFeedback();
    setNext();
    $('next').focus();
  }

  // A multiple-choice prompt with exactly one "___" becomes a drag-into-the-gap exercise.
  const gapParts = (q: Q) => {
    const parts = q.prompt.split('___');
    return q.options.length && !q.pics.length && parts.length === 2 ? parts : null;
  };

  function choose(idx: number) {
    if (checked[i]) return;
    answers[i] = idx;
    const opts = $('options');
    opts.querySelectorAll('.opt').forEach((el, k) => el.setAttribute('aria-pressed', String(k === idx)));
    const gap = $('prompt').querySelector('.blank');
    if (gap) {
      gap.textContent = questions[i].options[idx];
      opts.querySelectorAll('.opt').forEach((el, k) => el.classList.toggle('is-away', k === idx));
    }
    check();
  }

  // Pointer-based dragging (works with mouse and touch); a short press without movement counts as a tap.
  function makeDraggable(b: HTMLButtonElement, idx: number) {
    let ghost: HTMLElement | null = null;
    let sx = 0, sy = 0, dx = 0, dy = 0;
    let dragged = false;
    const gapAt = (x: number, y: number) => document.elementFromPoint(x, y)?.closest('.blank') ?? null;
    b.addEventListener('pointerdown', (e) => {
      if (checked[i] || e.button !== 0) return;
      sx = e.clientX; sy = e.clientY; dragged = false;
      const r = b.getBoundingClientRect();
      dx = e.clientX - r.left; dy = e.clientY - r.top;
      b.setPointerCapture(e.pointerId);
    });
    b.addEventListener('pointermove', (e) => {
      if (!b.hasPointerCapture(e.pointerId)) return;
      if (!dragged && Math.hypot(e.clientX - sx, e.clientY - sy) < 6) return;
      if (!ghost) {
        dragged = true;
        ghost = b.cloneNode(true) as HTMLElement;
        ghost.classList.add('drag-ghost');
        document.body.append(ghost);
        b.classList.add('is-away');
      }
      ghost.style.left = `${e.clientX - dx}px`;
      ghost.style.top = `${e.clientY - dy}px`;
      const gap = $('prompt').querySelector('.blank');
      gap?.classList.toggle('over', gapAt(e.clientX, e.clientY) === gap);
    });
    const end = (e: PointerEvent, drop: boolean) => {
      if (!ghost) return;
      ghost.remove();
      ghost = null;
      b.classList.remove('is-away');
      $('prompt').querySelector('.blank')?.classList.remove('over');
      if (drop && gapAt(e.clientX, e.clientY)) choose(idx);
    };
    b.addEventListener('pointerup', (e) => end(e, true));
    b.addEventListener('pointercancel', (e) => end(e, false));
    // Tap / keyboard: put the word into the gap directly. Swallow the click that follows a drag.
    b.addEventListener('click', () => {
      if (dragged) { dragged = false; return; }
      choose(idx);
    });
  }

  function renderQuestion() {
    const q = questions[i];
    $<HTMLProgressElement>('bar').value = i;
    $<HTMLProgressElement>('bar').max = questions.length;
    $('counter').textContent = `${ui.question} ${i + 1} ${ui.of} ${questions.length}`;
    const parts = gapParts(q);
    const prompt = $('prompt');
    if (parts) {
      const gap = document.createElement('span');
      gap.className = 'blank';
      if (typeof answers[i] === 'number') gap.textContent = q.options[answers[i] as number];
      prompt.replaceChildren(parts[0], gap, parts[1]);
    } else {
      prompt.textContent = q.prompt;
    }
    $('dragHint').hidden = !parts;
    const audio = $<HTMLAudioElement>('audio');
    audio.pause();
    $('player').hidden = !q.audio;
    if (q.audio) audio.src = q.audio;
    else audio.removeAttribute('src');

    // Picture markup comes from pictures.ts at build time, never from user input.
    const pic = $('pic');
    pic.hidden = !q.image;
    pic.innerHTML = q.image;

    const opts = $('options');
    opts.classList.toggle('bank', !!parts);
    opts.classList.toggle('pics', q.pics.length > 0);
    opts.classList.remove('done');
    const text = $<HTMLInputElement>('text');
    const typing = $('typing');
    opts.replaceChildren();
    if (q.options.length) {
      typing.hidden = true;
      opts.hidden = false;
      q.options.forEach((label, idx) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'opt';
        if (q.pics.length) {
          // The caption names the picture; it stays hidden until the answer is checked.
          b.innerHTML = q.pics[idx];
          const cap = document.createElement('span');
          cap.className = 'cap';
          cap.textContent = label;
          b.append(cap);
          b.setAttribute('aria-label', label);
        } else {
          b.textContent = label;
        }
        b.setAttribute('aria-pressed', String(answers[i] === idx));
        if (parts) makeDraggable(b, idx);
        else b.onclick = () => choose(idx);
        opts.append(b);
      });
    } else {
      opts.hidden = true;
      typing.hidden = false;
      text.value = typeof answers[i] === 'string' ? (answers[i] as string) : '';
      text.readOnly = false;
      text.classList.remove('is-right', 'is-wrong');
      text.focus();
    }
    showFeedback();
    setNext();
  }

  function advance() {
    if ($<HTMLButtonElement>('next').disabled) return;
    if (!checked[i]) return check();
    if (i < questions.length - 1) {
      i++;
      renderQuestion();
    } else {
      renderResult();
    }
  }

  // Level test result: score per level, the level reached, next steps and the topics with mistakes.
  function renderPlacement(p: Placement) {
    const rows = LEVELS.map((level) => {
      const ks = questions.map((q, k) => (q.level === level ? k : -1)).filter((k) => k >= 0);
      const right = ks.filter((k) => isCorrect(questions[k], answers[k])).length;
      return { level, right, total: ks.length, pass: ks.length > 0 && right / ks.length >= p.pass };
    });
    // A level counts only when every level below it is passed too.
    let reached = 0;
    while (reached < rows.length && rows[reached].pass) reached++;
    const out = p.outcomes[reached];
    $('score').textContent = out.level;
    $('verdict').textContent = out.text;

    $('levels').replaceChildren(...rows.map((r) => {
      const row = document.createElement('div');
      row.className = `lv${r.pass ? ' pass' : ''}`;
      const name = document.createElement('b');
      name.textContent = r.level;
      const track = document.createElement('div');
      track.className = 'track';
      const fill = document.createElement('div');
      fill.className = 'fill';
      fill.style.width = `${r.total ? (r.right / r.total) * 100 : 0}%`;
      track.append(fill);
      const n = document.createElement('span');
      n.textContent = `${r.right} / ${r.total}`;
      row.append(name, track, n);
      return row;
    }));

    $('nextLinks').replaceChildren(...out.links.map((l) => {
      const a = document.createElement('a');
      a.className = 'btn';
      a.href = l.href;
      a.textContent = l.label;
      return a;
    }));

    // Topics with mistakes, lowest level first — the place to continue from.
    const weak = [...new Set(questions.filter((q, k) => !isCorrect(q, answers[k])).map((q) => q.group))]
      .map((id) => p.topics[id])
      .filter(Boolean)
      .slice(0, 8);
    $('weak').hidden = !weak.length;
    $('weakList').replaceChildren(...weak.map((tp) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = tp.href;
      a.textContent = tp.title;
      li.append(a);
      return li;
    }));
  }

  function renderResult() {
    const correct = questions.filter((q, k) => isCorrect(q, answers[k])).length;
    const hit = cfg.verdicts.find((v) => correct / questions.length >= v.min);
    $('score').textContent = `${correct} / ${questions.length}`;
    $('verdict').textContent = hit ? hit.text : '';
    if (cfg.placement) renderPlacement(cfg.placement);
    track('quiz_complete', { quiz: quizId, score: correct, total: questions.length, result: cfg.placement ? $('score').textContent : undefined });

    const review = $('review');
    review.replaceChildren();
    questions.forEach((q, k) => {
      const ok = isCorrect(q, answers[k]);
      const a = answers[k];
      const given = a === null || a === '' || a === SKIPPED ? ui.noAnswer : typeof a === 'number' ? q.options[a] : a;
      const right = q.answer >= 0 ? q.options[q.answer] : q.accept[0];

      const row = document.createElement('div');
      row.className = 'rev';
      const head = document.createElement('div');
      head.textContent = `${k + 1}. ${q.prompt}`;
      const line = document.createElement('div');
      line.className = ok ? 'ok' : 'bad';
      line.textContent = `${ok ? '✓' : '✗'} ${ui.yourAnswer}: ${given}`;
      if (q.image) {
        const pic = document.createElement('div');
        pic.className = 'pic-box small';
        pic.innerHTML = q.image;
        head.append(pic);
      }
      row.append(head, line);
      if (!ok) {
        const c = document.createElement('div');
        c.className = 'ok';
        c.textContent = `${ui.correctAnswer}: ${right}`;
        row.append(c);
      }
      const ex = document.createElement('div');
      ex.className = 'muted';
      ex.textContent = q.explain;
      row.append(ex);
      review.append(row);
    });
    show('result');
  }

  // New random order every attempt: questions, and the options inside each question.
  const shuffleOptions = (q: Q): Q => {
    if (!q.options.length) return q;
    const order = shuffled(q.options.map((_, k) => k));
    const pics = q.pics.length ? order.map((k) => q.pics[k]) : q.pics;
    return { ...q, options: order.map((k) => q.options[k]), pics, answer: order.indexOf(q.answer) };
  };

  // Level test: a few random topics per level, one question each; levels go in order, easiest first.
  const buildPlacement = (p: Placement): Q[] =>
    LEVELS.flatMap((level) => {
      const byGroup = new Map<string, Q[]>();
      cfg.questions.filter((q) => q.level === level).forEach((q) => byGroup.set(q.group, [...(byGroup.get(q.group) ?? []), q]));
      return shuffled([...byGroup.values()]).slice(0, p.perLevel).map((g) => shuffled(g)[0]);
    }).map(shuffleOptions);

  const buildRun = (): Q[] => {
    if (cfg.placement) return buildPlacement(cfg.placement);
    let pool = cfg.questions;
    if (cfg.perGroup > 0) {
      const byGroup = new Map<string, Q[]>();
      pool.forEach((q) => byGroup.set(q.group, [...(byGroup.get(q.group) ?? []), q]));
      pool = [...byGroup.values()].flatMap((g) => shuffled(g).slice(0, cfg.perGroup));
    }
    return shuffled(pool).map(shuffleOptions);
  };

  // Short shuffling animation before the first question.
  const LOADER_MS = matchMedia('(prefers-reduced-motion: reduce)').matches ? 800 : 2600;
  let starting = false;
  $('start').onclick = () => {
    if (starting) return;
    starting = true;
    questions = buildRun();
    track('quiz_start', { quiz: quizId });
    i = 0;
    answers = questions.map(() => null);
    checked = questions.map(() => false);
    show('loader');
    setTimeout(() => {
      starting = false;
      show('quiz');
      renderQuestion();
    }, LOADER_MS);
  };
  document.querySelectorAll<HTMLButtonElement>('.letter').forEach((b) => {
    b.onclick = () => {
      if (checked[i]) return;
      const f = $<HTMLInputElement>('text');
      f.value += b.textContent;
      f.focus();
      answers[i] = f.value;
      setNext();
    };
  });
  // "Slower" plays the same file at 0.75×; browsers keep the pitch, so the voice stays natural.
  const slow = $<HTMLButtonElement>('slow');
  slow.onclick = () => {
    const on = slow.getAttribute('aria-pressed') !== 'true';
    slow.setAttribute('aria-pressed', String(on));
    $<HTMLAudioElement>('audio').playbackRate = on ? 0.75 : 1;
  };
  // Setting src resets the rate in some browsers, so re-apply it whenever a new file loads.
  $<HTMLAudioElement>('audio').addEventListener('loadstart', (e) => {
    (e.target as HTMLAudioElement).playbackRate = slow.getAttribute('aria-pressed') === 'true' ? 0.75 : 1;
  });
  $('next').onclick = advance;
  const skip = document.getElementById('skip');
  if (skip) skip.onclick = () => {
    if (checked[i]) return;
    answers[i] = SKIPPED;
    check();
  };
  $('retry').onclick = () => show('intro');
  $<HTMLInputElement>('text').addEventListener('input', (e) => {
    if (checked[i]) return;
    answers[i] = (e.target as HTMLInputElement).value;
    setNext();
  });
  $<HTMLInputElement>('text').addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    // Otherwise the same key press would also activate #next, which just got focus, and skip the feedback.
    e.preventDefault();
    advance();
  });
</script>
