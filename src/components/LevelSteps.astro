---
interface Props {
  lang: string;
  labels: [string, string, string];
}
const { lang, labels } = Astro.props;
const rows = [
  { level: 'A1', y: 24, active: true, href: `/${lang}/topics#a1` },
  { level: 'A2', y: 108, active: true, href: `/${lang}/topics#a2` },
  { level: 'B1', y: 192, active: true, href: `/${lang}/topics#b1` },
];
---
<svg viewBox="0 0 360 280" width="100%" role="img" aria-label={labels.join(', ')}>
  <rect x="1" y="1" width="358" height="278" rx="16" fill="var(--card)" stroke="var(--line)" />
  {rows.map((r, i) => {
    const row = (
      <g class={`row${r.active ? ' active' : ''}`}>
        <rect class="box" x="20" y={r.y} width="320" height="64" rx="12"
          fill={r.active ? 'var(--accent)' : 'none'} fill-opacity={r.active ? 0.12 : 0}
          stroke={r.active ? 'var(--accent)' : 'var(--line)'} stroke-width={r.active ? 2 : 1} />
        <text class="lvl" x="40" y={r.y + 40} font-size="22" font-weight="700" fill={r.active ? 'var(--accent)' : 'var(--muted)'}>{r.level}</text>
        <text x="100" y={r.y + 38} font-size="15" fill="var(--muted)">{labels[i]}</text>
      </g>
    );
    return r.href ? <a href={r.href} aria-label={`${r.level} — ${labels[i]}`}>{row}</a> : row;
  })}
</svg>

<style>
  .row { cursor: pointer; outline: none; }
  .row .box, .row .lvl { transition: fill .2s, fill-opacity .2s, stroke .2s, stroke-width .2s; }
  .row:hover .box, a:focus-visible .box { fill: var(--accent); fill-opacity: .12; stroke: var(--accent); stroke-width: 2; }
  .row:hover .lvl, a:focus-visible .lvl { fill: var(--accent); }
  /* while any row is hovered, the default highlight steps aside */
  svg:hover .row.active:not(:hover) .box { fill: none; fill-opacity: 0; stroke: var(--line); stroke-width: 1; }
  svg:hover .row.active:not(:hover) .lvl { fill: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .row .box, .row .lvl { transition: none; } }
</style>
