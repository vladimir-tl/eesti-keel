---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n/ui';
import type { ExamPage } from '../data/exam-a2';
import type { Level } from '../data/questions';
import LevelTopics from './LevelTopics.astro';

interface Props {
  lang: Lang;
  e: ExamPage;
  slug: string; // page path, e.g. exam-a2
  testPath: string; // practice test page
  topicsPath: string; // topics page with the level anchor
  about: string;
  modified: string;
  level: Level; // the topics of this level are linked under the exam topics
}
const { lang, e, slug, testPath, topicsPath, about, modified, level } = Astro.props;
const s = ui[lang];
const abs = (p: string) => new URL(p, Astro.site).href;

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: e.h1,
  description: e.description,
  inLanguage: lang,
  dateModified: modified,
  mainEntityOfPage: abs(`/${lang}/${slug}`),
  about: { '@type': 'Thing', name: about },
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: e.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    [s.home, `/${lang}`],
    [e.h1, `/${lang}/${slug}`],
  ].map(([name, p], k) => ({ '@type': 'ListItem', position: k + 1, name, item: abs(p) })),
};
---
<Base lang={lang} path={slug} title={e.title} description={e.description} jsonLd={[article, faq, breadcrumbs]}>
  <nav class="crumbs muted" aria-label="breadcrumb">
    <a href={`/${lang}`}>{s.home}</a>
    <span class="sep" aria-hidden="true">›</span>
    <span aria-current="page">{e.h1}</span>
  </nav>

  <article class="exam">
    <h1>{e.h1}</h1>
    <p class="lead">{e.lead}</p>
    <p class="muted small">{e.checked}</p>

    <section class="card box">
      <h2>{e.factsTitle}</h2>
      <dl class="facts">
        {e.facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      </dl>
      <div class="cta">
        <a class="btn" href={`/${lang}/${testPath}`}>{e.ctaTest}</a>
        <a class="muted" href={`/${lang}/${topicsPath}`}>{e.ctaTopics}</a>
      </div>
    </section>

    <section>
      <h2>{e.partsTitle}</h2>
      <p class="muted">{e.partsNote}</p>
      <div class="parts">
        {e.parts.map((p) => (
          <div class="card part">
            <div class="part-head">
              <h3>{p.name}</h3>
              <span class="chips">
                <span class="chip" title={e.colTime}>{p.time}</span>
                <span class="chip" title={e.colPoints}>{p.points} {{ ru: 'б.', en: 'pts', et: 'p' }[lang]}</span>
              </span>
            </div>
            <ul>{p.tasks.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>{e.passTitle}</h2>
      <ul>{e.pass.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section>
      <h2>{e.regTitle}</h2>
      <ul>{e.reg.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section>
      <h2>{e.dayTitle}</h2>
      <ul>{e.day.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section>
      <h2>{e.topicsTitle}</h2>
      <p>{e.topicsText}</p>
      <LevelTopics lang={lang} level={level} />
    </section>

    <section>
      <h2>{e.prepTitle}</h2>
      <ul>{e.prep.map((x) => <li>{x}</li>)}</ul>
      <div class="cta">
        <a class="btn" href={`/${lang}/${testPath}`}>{e.ctaTest}</a>
        <a class="muted" href={`/${lang}/${topicsPath}`}>{e.ctaTopics}</a>
      </div>
    </section>

    <section>
      <h2>{e.faqTitle}</h2>
      {e.faq.map(([q, a]) => (
        <details class="faq">
          <summary><h3>{q}</h3></summary>
          <p>{a}</p>
        </details>
      ))}
    </section>

    <section>
      <h2>{e.sourcesTitle}</h2>
      <ul>{e.sources.map(([name, href]) => <li><a href={href} rel="noopener" target="_blank">{name}</a></li>)}</ul>
    </section>
  </article>
</Base>

<style>
  .crumbs { max-width: 720px; margin: 0 auto 16px; font-size: .875rem; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .crumbs a { color: inherit; }
  .crumbs [aria-current] { color: var(--fg); }
  .sep { opacity: .6; }
  .exam { max-width: 720px; margin: 0 auto; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); line-height: 1.15; margin: 8px 0 12px; }
  h2 { font-size: 1.35rem; margin: 32px 0 12px; }
  .lead { font-size: 1.1rem; margin: 0 0 8px; }
  .small { font-size: .85rem; }
  .box { max-width: none; margin: 24px 0 0; }
  .box h2 { margin-top: 0; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 16px; margin: 0 0 20px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; font-weight: 600; }
  @media (max-width: 520px) {
    .facts { grid-template-columns: 1fr; gap: 2px; }
    .facts dd { margin-bottom: 8px; }
  }
  .cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 16px; }
  .parts { display: grid; gap: 12px; }
  .part { max-width: none; margin: 0; padding: 16px 20px; }
  .part-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .part h3 { margin: 0; font-size: 1.1rem; }
  .chips { display: flex; gap: 6px; }
  .chip { padding: 2px 10px; border: 1px solid var(--line); border-radius: 10px; font-size: .85rem; color: var(--accent); white-space: nowrap; }
  .part ul { margin: 10px 0 0; padding-left: 20px; }
  li { margin: 4px 0; line-height: 1.5; }
  .faq { border-bottom: 1px solid var(--line); }
  .faq summary { padding: 12px 0; cursor: pointer; list-style-position: outside; }
  .faq summary h3 { display: inline; font-size: 1rem; font-weight: 600; margin: 0; }
  .faq p { margin: 0 0 14px; }
  a { color: var(--accent); }
  .btn { color: #fff; }
</style>
