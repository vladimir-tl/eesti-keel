---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import { topics } from '../data/topics';
import { t } from '../data/questions';

/** A few B1 topics that readers look for most, linked from pages Google already visits often. */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ids = ['opinions', 'participles', 'economy', 'workplace', 'online-shop', 'illness'];
const list = ids.map((id) => topics.find((tp) => tp.id === id)!);
---
<section class="popular">
  <h2>{ui[lang].popularB1}</h2>
  <ul>
    {list.map((tp) => (
      <li>
        <a href={`/${lang}/topics/${tp.id}`}>{t(tp.title, lang)}</a>
        <span class="muted">{t(tp.desc, lang)}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .popular { max-width: 640px; margin: 40px auto 0; }
  .popular h2 { margin: 0 0 12px; font-size: 1.15rem; }
  .popular ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .popular li { display: flex; flex-direction: column; gap: 2px; }
  .popular a { color: var(--accent); }
  .popular .muted { font-size: .875rem; }
</style>
