---
import ExamArticle from '../../components/ExamArticle.astro';
import { langs, type Lang } from '../../i18n/ui';
import { examA2 } from '../../data/exam-a2';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const about = { ru: 'Экзамен A2 по эстонскому языку', en: 'Estonian A2 proficiency exam', et: 'Eesti keele A2-taseme eksam' }[lang];
---
<ExamArticle lang={lang} e={examA2[lang]} slug="exam-a2" testPath="test-a2" topicsPath="topics#a2" about={about} modified="2026-09-25" />
