---
import Base from '../../../layouts/Base.astro';
import { fill, langs, ui, type Lang } from '../../../i18n/ui';
import { groupsOf, topics } from '../../../data/topics';
import { t, type Level } from '../../../data/questions';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = ui[lang];

const levels: { level: Level; label: string; test: string; testTitle: string; testText: string }[] = [
  { level: 'A1', label: s.levelA1, test: `/${lang}/test`, testTitle: s.introTitle, testText: s.introText },
  { level: 'A2', label: s.levelA2, test: `/${lang}/test-a2`, testTitle: s.introTitleA2, testText: s.introTextA2 },
];
const number = (level: Level, id: string) =>
  groupsOf(level).flatMap((g) => g.topics).findIndex((x) => x.id === id) + 1;
---
<Base lang={lang} path="topics" title={s.seoTopicsTitle} description={fill(s.seoTopicsDesc, { n: topics.length })}>
  <div class="head">
    <h1>{s.topicsTitle}</h1>
    <p class="muted">{topics.length} {s.topicsCount} · {s.topicsSub}</p>
  </div>

  {levels.map((lv) => (
    <section class="level" id={lv.level.toLowerCase()}>
      <h2 class="level-title"><span class="chip">{lv.level}</span> {lv.label}</h2>
      {lv.level === 'A2' && <p class="muted note">{s.a2Note} <a href={`/${lang}/exam-a2`}>{s.examCta} →</a></p>}
      {groupsOf(lv.level).map((g) => (
        <section class="group" id={g.id}>
          <h3 class="group-title"><a class="anchor" href={`#${g.id}`}>{t(g.title, lang)}</a> <span class="muted small">{g.topics.length} {s.topicsCount}</span></h3>
          <div class="grid">
            {g.topics.map((tp) => (
              <a class="card topic" href={`/${lang}/topics/${tp.id}`}>
                <span class="num">{number(lv.level, tp.id)}</span>
                <h4>{t(tp.title, lang)}</h4>
                <p class="muted">{tp.desc}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
      <section class="group">
        <h3 class="group-title">{lv.level === 'A1' ? s.testCta : s.testCtaA2}</h3>
        <a class="card topic" href={lv.test}>
          <span class="num">★</span>
          <h4>{lv.testTitle}</h4>
          <p class="muted">{lv.testText}</p>
        </a>
      </section>
    </section>
  ))}
</Base>

<style>
  .head { margin: 0 0 24px; }
  .group { margin-bottom: 32px; scroll-margin-top: 16px; }
  .anchor { color: inherit; text-decoration: none; }
  .anchor:hover { color: var(--accent); }
  .level { margin-bottom: 48px; scroll-margin-top: 16px; }
  .level-title { font-size: 1.5rem; margin: 0 0 20px; padding-bottom: 8px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 12px; }
  .note { margin: -8px 0 20px; font-size: .875rem; }
  .chip { padding: 2px 12px; border-radius: 10px; background: var(--accent); color: #fff; font-size: 1.1rem; }
  .group-title { font-size: 1.35rem; font-weight: 700; margin: 0 0 14px; }
  .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .topic { max-width: none; margin: 0; padding: 16px; color: inherit; text-decoration: none; }
  .topic { transition: transform .15s, border-color .15s, box-shadow .15s, background-color .15s; }
  .topic:hover, .topic:focus-visible {
    border-color: var(--accent); transform: translateY(-3px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, .12);
    background: color-mix(in srgb, var(--accent) 6%, var(--card));
  }
  @media (prefers-reduced-motion: reduce) { .topic { transition: none; } .topic:hover { transform: none; } }
  .topic h4 { margin: 4px 0; font-size: 1.05rem; }
  .topic p { margin: 0; font-size: .875rem; }
  .num { color: var(--accent); font-weight: 700; }
  .small { font-size: .8rem; font-weight: 400; }
</style>
