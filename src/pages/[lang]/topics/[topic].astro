---
import Base from '../../../layouts/Base.astro';
import Quiz from '../../../components/Quiz.astro';
import { fill, langs, ui, type Lang } from '../../../i18n/ui';
import { groups, topics } from '../../../data/topics';
import { t } from '../../../data/questions';
import { hints } from '../../../data/hints';
import { topicSeo } from '../../../data/topic-seo';
import { topicNotes } from '../../../data/topic-notes';

export const getStaticPaths = () =>
  langs.flatMap((lang) => topics.map((tp) => ({ params: { lang, topic: tp.id }, props: { tp } })));
const lang = Astro.params.lang as Lang;
const { tp } = Astro.props;
const s = ui[lang];

const group = groups.find((g) => g.topics.some((x) => x.id === tp.id))!;
const title = t(tp.title, lang);
const topicIndex = group.topics.findIndex((item) => item.id === tp.id);
const relatedTopics = group.topics
  .map((item, index) => ({ item, index }))
  .filter(({ index }) => index !== topicIndex)
  .sort((a, b) => Math.abs(a.index - topicIndex) - Math.abs(b.index - topicIndex) || a.index - b.index)
  .slice(0, 3)
  .sort((a, b) => a.index - b.index)
  .map(({ item }) => item);
const seo = { topic: title, level: group.level, desc: t(tp.desc, lang), n: tp.questions.length };
const snippet = topicSeo[tp.id]?.[lang] ?? { title: s.seoTopicTitle, desc: s.seoTopicDesc };
const abs = (p: string) => new URL(p, Astro.site).href;

// The written-out rule under the quiz; **bold** marks Estonian forms, as in the hints.
const notes = topicNotes[tp.id]?.[lang] ?? [];
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const md = (x: string) => esc(x).replace(/\*\*(.+?)\*\*/g, '<strong lang="et">$1</strong>');
const topicById = (id: string) => topics.find((x) => x.id === id)!;

// Vocabulary practised in the topic, as plain text for readers and search engines.
// Prompt-only notes such as "(Ta kutsub …)" are dropped.
const words = [...new Map(
  tp.questions
    .filter((q) => q.pair)
    .map((q) => [q.pair!.et.toLowerCase(), { et: q.pair!.et, tr: t(q.pair!.tr, lang).replace(/\s*\([^)]*…[^)]*\)/g, '') }]),
).values()];
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    [s.home, `/${lang}`],
    [`${s.topicsTitle} ${group.level}`, `/${lang}/topics#${group.level.toLowerCase()}`],
    [t(group.title, lang), `/${lang}/topics#${group.id}`],
    [title, `/${lang}/topics/${tp.id}`],
  ].map(([name, p], k) => ({ '@type': 'ListItem', position: k + 1, name, item: abs(p) })),
};
---
<Base lang={lang} path={`topics/${tp.id}`} title={fill(snippet.title, seo)} description={fill(snippet.desc, seo)} jsonLd={[breadcrumbs]}>
  <nav class="crumbs muted" aria-label="breadcrumb">
    <a href={`/${lang}`}>{s.home}</a>
    <span class="sep" aria-hidden="true">›</span>
    <a href={`/${lang}/topics#${group.level.toLowerCase()}`}>{s.topicsTitle} {group.level}</a>
    <span class="sep" aria-hidden="true">›</span>
    <a href={`/${lang}/topics#${group.id}`}>{t(group.title, lang)}</a>
    <span class="sep" aria-hidden="true">›</span>
    <span aria-current="page">{t(tp.title, lang)}</span>
  </nav>

  <Quiz lang={lang} title={t(tp.title, lang)} intro={t(tp.desc, lang)}
    hint={hints[tp.id]?.[lang]} questions={tp.questions} verdicts={s.verdictsTopic} />

  {notes.length > 0 && (
    <article class="notes">
      {notes.map((sec) => (
        <section>
          <h2>{sec.h}</h2>
          {sec.p?.map((x) => <p set:html={md(x)} />)}
          {sec.table && (
            <div class="table-wrap">
              <table lang="et">
                <thead><tr>{sec.table.head.map((x) => <th scope="col">{x}</th>)}</tr></thead>
                <tbody>{sec.table.rows.map(([first, ...rest]) => (
                  <tr><th scope="row">{first}</th>{rest.map((x) => <td>{x}</td>)}</tr>
                ))}</tbody>
              </table>
            </div>
          )}
          {sec.examples && (
            <dl class="examples">
              {sec.examples.map(([et, tr]) => (<><dt lang="et">{et}</dt><dd>{tr}</dd></>))}
            </dl>
          )}
          {sec.list && <ul>{sec.list.map((x) => <li set:html={md(x)} />)}</ul>}
          {sec.links && (
            <ul>{sec.links.map((id) => <li><a href={`/${lang}/topics/${id}`}>{t(topicById(id).title, lang)}</a></li>)}</ul>
          )}
        </section>
      ))}
    </article>
  )}

  {words.length > 0 && (
    <details class="words">
      <summary>{s.wordsTitle} ({words.length})</summary>
      <dl>
        {words.map((w) => (<><dt lang="et">{w.et}</dt><dd>{w.tr}</dd></>))}
      </dl>
    </details>
  )}

  {relatedTopics.length > 0 && (
    <nav class="related" aria-label={s.relatedTopics}>
      <h2>{s.relatedTopics}</h2>
      <ul>
        {relatedTopics.map((item) => (
          <li><a href={`/${lang}/topics/${item.id}`}>{t(item.title, lang)}</a></li>
        ))}
      </ul>
    </nav>
  )}

</Base>

<style>
  .crumbs { max-width: 640px; margin: 0 auto 16px; font-size: .875rem; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .sep { opacity: .6; }
  .crumbs a { color: inherit; }
  .words { max-width: 640px; margin: 16px auto 0; border: 1px solid var(--line); border-radius: 16px; background: var(--card); }
  .words summary { padding: 14px 20px; cursor: pointer; color: var(--accent); }
  .words dl { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 6px 16px; margin: 0; padding: 0 20px 16px; }
  .words dt { font-weight: 600; }
  .words dd { margin: 0; color: var(--muted); }
  .crumbs [aria-current] { color: var(--fg); }
  .notes { max-width: 640px; margin: 24px auto 0; padding: 4px 24px 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); }
  .notes h2 { margin: 20px 0 10px; font-size: 1.15rem; }
  .notes p, .notes li { line-height: 1.55; }
  .notes p { margin: 0 0 10px; }
  .notes ul { margin: 0; padding-left: 20px; }
  .notes li + li { margin-top: 8px; }
  .notes a { color: var(--accent); }
  .table-wrap { overflow-x: auto; }
  .notes table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  .notes th, .notes td { text-align: left; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); }
  .notes thead th { color: var(--muted); font-weight: 600; font-size: .85rem; }
  .examples { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 16px; margin: 0; }
  .examples dt, .examples dd { margin: 0; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .examples dt { font-weight: 600; }
  .examples dd { color: var(--muted); }
  @media (max-width: 520px) {
    .notes { padding: 4px 16px 16px; }
    .examples { grid-template-columns: 1fr; }
    .examples dt { border-bottom: 0; padding-bottom: 0; }
    .examples dd { padding-top: 2px; }
  }
  .related { max-width: 640px; margin: 24px auto 0; padding: 20px 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); }
  .related h2 { margin: 0 0 12px; font-size: 1.15rem; }
  .related ul { margin: 0; padding-left: 20px; }
  .related li + li { margin-top: 8px; }
  .related a { color: var(--accent); }
</style>
