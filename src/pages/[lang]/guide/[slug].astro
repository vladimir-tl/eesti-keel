---
import Base from '../../../layouts/Base.astro';
import { langs, ui, type Lang } from '../../../i18n/ui';
import { guides, guidesUpdated, type Guide } from '../../../data/guides';

export const getStaticPaths = () =>
  langs.flatMap((lang) => guides[lang].map((g) => ({ params: { lang, slug: g.slug }, props: { guide: g } })));

const lang = Astro.params.lang as Lang;
const { guide: g } = Astro.props as { guide: Guide };
const s = ui[lang];
const path = `guide/${g.slug}`;
const abs = (p: string) => new URL(p, Astro.site).href;
const isExternal = (href: string) => /^https?:/.test(href);
const hrefOf = (href: string) => (isExternal(href) ? href : `/${lang}/${href}`);
const others = guides[lang].filter((x) => x.slug !== g.slug);

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.h1,
  description: g.description,
  inLanguage: lang,
  dateModified: guidesUpdated,
  mainEntityOfPage: abs(`/${lang}/${path}`),
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    [s.home, `/${lang}`],
    [s.navArticles, `/${lang}/guide`],
    [g.h1, `/${lang}/${path}`],
  ].map(([name, p], k) => ({ '@type': 'ListItem', position: k + 1, name, item: abs(p) })),
};
---
<Base lang={lang} path={path} title={g.title} description={g.description} jsonLd={[article, breadcrumbs]}>
  <nav class="crumbs muted" aria-label="breadcrumb">
    <a href={`/${lang}`}>{s.home}</a>
    <span class="sep" aria-hidden="true">›</span>
    <a href={`/${lang}/guide`}>{s.navArticles}</a>
    <span class="sep" aria-hidden="true">›</span>
    <span aria-current="page">{g.h1}</span>
  </nav>

  <article class="guide">
    <h1>{g.h1}</h1>
    <p class="lead">{g.lead}</p>

    {g.sections.map((sec) => (
      <section>
        <h2>{sec.h}</h2>
        {sec.p?.map((x) => <p>{x}</p>)}
        {sec.table && (
          <div class="table-wrap">
            <table>
              <thead><tr>{sec.table.head.map((x) => <th scope="col">{x}</th>)}</tr></thead>
              <tbody>{sec.table.rows.map(([first, ...rest]) => (
                <tr><th scope="row">{first}</th>{rest.map((x) => <td>{x}</td>)}</tr>
              ))}</tbody>
            </table>
          </div>
        )}
        {sec.list && <ul>{sec.list.map((x) => <li>{x}</li>)}</ul>}
        {sec.phrases && (
          <dl class="phrases">
            {sec.phrases.map(([et, t]) => (<><dt lang="et">{et}</dt><dd>{t}</dd></>))}
          </dl>
        )}
        {sec.after?.map((x) => <p>{x}</p>)}
        {sec.samples?.map((x) => (
          <figure class="card sample">
            <figcaption class="muted">{x.label}</figcaption>
            <p class="et" lang="et">{x.et}</p>
            <details>
              <summary>{s.translation}</summary>
              <p class="tr">{x.tr}</p>
            </details>
          </figure>
        ))}
        {sec.links && (
          <ul class="links">
            {sec.links.map(([label, href, note]) => (
              <li>
                {isExternal(href)
                  ? <a href={href} rel="noopener" target="_blank">{label}</a>
                  : <a href={hrefOf(href)}>{label}</a>}
                {note && <span class="muted note">{note}</span>}
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <p class="muted small">{s.guideChecked}</p>

    <section class="more">
      <h2>{s.moreGuides}</h2>
      <ul class="links">
        <li><a href={`/${lang}/exam-a2`}>{s.examCta}</a></li>
        <li><a href={`/${lang}/exam-b1`}>{s.examCtaB1}</a></li>
        {others.map((x) => <li><a href={`/${lang}/guide/${x.slug}`}>{x.h1}</a></li>)}
      </ul>
    </section>
  </article>
</Base>

<style>
  .crumbs { max-width: 720px; margin: 0 auto 16px; font-size: .875rem; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .crumbs a { color: inherit; }
  .crumbs [aria-current] { color: var(--fg); }
  .sep { opacity: .6; }
  .guide { max-width: 720px; margin: 0 auto; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); line-height: 1.15; margin: 8px 0 12px; }
  h2 { font-size: 1.35rem; margin: 32px 0 12px; }
  .lead { font-size: 1.1rem; margin: 0 0 8px; }
  .small { font-size: .85rem; margin-top: 32px; }
  li { margin: 4px 0; line-height: 1.5; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  th, td { text-align: left; vertical-align: top; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); }
  thead th { color: var(--muted); font-weight: 600; font-size: .85rem; }
  tbody th { font-weight: 600; white-space: nowrap; }
  td:nth-child(2) { white-space: nowrap; }
  @media (max-width: 560px) {
    tbody th, td:nth-child(2) { white-space: normal; }
  }
  .phrases { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 16px; margin: 12px 0; }
  .phrases dt, .phrases dd { margin: 0; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .phrases dt { font-weight: 600; }
  @media (max-width: 520px) {
    .phrases { grid-template-columns: 1fr; }
    .phrases dt { border-bottom: 0; padding-bottom: 0; }
    .phrases dd { padding-top: 2px; color: var(--muted); }
  }
  .sample { max-width: none; margin: 16px 0 0; padding: 16px 20px; }
  .sample figcaption { font-size: .85rem; margin-bottom: 8px; }
  .sample .et, .sample .tr { white-space: pre-line; margin: 0; }
  .sample details { margin-top: 12px; }
  .sample summary { cursor: pointer; color: var(--accent); font-size: .9rem; }
  .sample .tr { margin-top: 8px; color: var(--muted); }
  .links { padding-left: 20px; }
  .note { display: block; }
  a { color: var(--accent); }
</style>
