---
import Base from '../../layouts/Base.astro';
import Quiz, { type Placement } from '../../components/Quiz.astro';
import Notes from '../../components/Notes.astro';
import { langs, ui, type Lang } from '../../i18n/ui';
import { topicsOf } from '../../data/topics';
import { t } from '../../data/questions';
import { levelTestNotes, notesFaq } from '../../data/test-notes';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = ui[lang];

// Every level comes from its topic banks: the test draws one question per topic, ten topics per level.
const levels = ['A1', 'A2', 'B1'] as const;
const questions = levels.flatMap((level) =>
  topicsOf(level).flatMap((tp) => tp.questions.map((q) => ({ ...q, level, group: tp.id }))),
);

const href = (p: string) => `/${lang}/${p}`;
const placement: Placement = {
  perLevel: 10,
  pass: 0.7,
  outcomes: [
    { ...s.place.pre, links: [{ href: href('topics#a1'), label: s.topicsCtaA1 }, { href: href('test'), label: s.testCta }] },
    { ...s.place.a1, links: [{ href: href('topics#a2'), label: s.topicsCtaA2 }, { href: href('test-a2'), label: s.testCtaA2 }] },
    { ...s.place.a2, links: [{ href: href('exam-a2'), label: s.examCta }, { href: href('test-a2'), label: s.testCtaA2 }] },
    { ...s.place.b1, links: [{ href: href('topics#b1'), label: s.topicsCtaB1 }, { href: href('test-b1'), label: s.testCtaB1 }, { href: href('exam-b1'), label: s.examCtaB1 }] },
  ],
  topics: Object.fromEntries(
    levels.flatMap((level) => topicsOf(level)).map((tp) => [tp.id, { href: href(`topics/${tp.id}`), title: t(tp.title, lang) }]),
  ),
};
---
<Base lang={lang} path="level-test" title={s.seoLevelTitle} description={s.seoLevelDesc} jsonLd={[notesFaq(levelTestNotes[lang])]}>
  <Quiz lang={lang} title={s.levelTestTitle} intro={s.levelTestIntro} questions={questions} verdicts={[]}
    placement={placement} />
  <Notes lang={lang} sections={levelTestNotes[lang]} hideInQuiz />
</Base>
