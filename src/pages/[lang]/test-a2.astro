---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.astro';
import { langs, ui, type Lang } from '../../i18n/ui';
import { topicsOf } from '../../data/topics';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = ui[lang];
// Every topic's questions go in; the quiz draws one random question per topic on each attempt.
const questions = topicsOf('A2').flatMap((tp) => tp.questions.map((q) => ({ ...q, group: tp.id })));
---
<Base lang={lang} path="test-a2" title={s.seoTestA2Title} description={s.seoTestA2Desc}>
  <Quiz lang={lang} title={s.introTitleA2} intro={s.introTextA2} questions={questions} perGroup={1}
    verdicts={s.verdictsTestA2} backHref={`/${lang}/topics`} backLabel={s.topicsTitle} />
</Base>
