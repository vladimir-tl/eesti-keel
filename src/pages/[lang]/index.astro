---
import Base from '../../layouts/Base.astro';
import LevelSteps from '../../components/LevelSteps.astro';
import PopularTopics from '../../components/PopularTopics.astro';
import { langs, ui, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = ui[lang];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base lang={lang} title={s.seoHomeTitle} description={s.seoHomeDesc} jsonLd={[faqLd]}>
  <section class="hero">
    <div>
      <span class="badge">{s.badge}</span>
      <h1>{s.heroBefore} <em>{s.heroAccent}</em></h1>
      <p class="muted">{s.heroSub}</p>
      <a class="btn hero-cta" href={`/${lang}/level-test`}>{s.promoCta}</a>
      <p class="hero-note muted">{s.promoCtaNote}</p>
      <div class="hero-links">
        {[
          { href: 'test', label: s.testCta, note: s.testCtaNote },
          { href: 'test-a2', label: s.testCtaA2, note: s.testCtaA2Note },
          { href: 'test-b1', label: s.testCtaB1, note: s.testCtaB1Note },
          { href: 'topics#a1', label: s.topicsCtaA1, note: s.topicsCtaA1Note },
          { href: 'topics#a2', label: s.topicsCtaA2, note: s.topicsCtaA2Note },
          { href: 'topics#b1', label: s.topicsCtaB1, note: s.topicsCtaB1Note },
        ].map((l) => (
          <a href={`/${lang}/${l.href}`}>
            <span class="hero-link-label">{l.label}</span>
            <span class="hero-link-note muted">{l.note}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="art">
      <LevelSteps lang={lang} labels={[s.levelA1, s.levelA2, s.levelB1]} />
    </div>
  </section>

  <section class="audience panel">
    <h2>{s.audienceBefore} <em>{s.audienceAccent}</em></h2>
    <div class="aud-grid">
      {s.audience.map((a) => (
        <div class="aud">
          <svg class="aud-icon" viewBox="0 0 24 24" aria-hidden="true">
            {a.icon === 'exam' && (<><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 12l2 2 4-4" /></>)}
            {a.icon === 'move' && (<><path d="M3 11l9-7 9 7" /><path d="M5 10v10h14V10" /><path d="M10 20v-5h4v5" /></>)}
            {a.icon === 'grow' && (<><path d="M12 21v-9" /><path d="M12 12c0-4 3-6 7-6 0 4-3 6-7 6z" /><path d="M12 15c0-3-2-5-6-5 0 3 2 5 6 5z" /></>)}
            {a.icon === 'career' && (<><path d="M4 20h16" /><path d="M6 16l4-4 3 3 5-6" /><path d="M14 9h4v4" /></>)}
          </svg>
          <h3>{a.title}</h3>
          <p class="muted">{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="promo panel">
    <div class="promo-text">
      <h2>{s.promoBefore} <em>{s.promoAccent}</em></h2>
      <p class="muted">{s.promoSub}</p>
      <span class="badge">{s.promoBadge}</span>
      <div class="cta">
        <a class="btn" href={`/${lang}/level-test`}>{s.promoCta}</a>
        <a class="muted" href={`/${lang}/test-a2`}>{s.promoA2}</a>
      </div>
    </div>
    <!-- A sketch of a quiz card: a gap sentence and the right answer ticked. -->
    <svg class="promo-art" viewBox="0 0 320 220" aria-hidden="true">
      <rect x="1" y="1" width="318" height="218" rx="16" fill="var(--card)" stroke="var(--line)" />
      <rect x="24" y="24" width="272" height="6" rx="3" fill="var(--line)" />
      <rect x="24" y="24" width="150" height="6" rx="3" fill="var(--accent)" />
      <text x="24" y="66" font-size="20" fill="var(--fg)">Ma elan</text>
      <rect x="104" y="46" width="98" height="28" rx="6" fill="var(--ok)" fill-opacity=".14" />
      <line x1="104" y1="74" x2="202" y2="74" stroke="var(--ok)" stroke-width="2" />
      <text x="153" y="66" font-size="18" font-weight="700" fill="var(--ok)" text-anchor="middle">Tallinnas</text>
      <text x="208" y="66" font-size="20" fill="var(--fg)">.</text>
      <rect x="24" y="96" width="86" height="34" rx="10" fill="none" stroke="var(--line)" />
      <text x="67" y="118" font-size="14" fill="var(--muted)" text-anchor="middle">Tallinn</text>
      <rect x="118" y="96" width="104" height="34" rx="10" fill="var(--ok)" fill-opacity=".12" stroke="var(--ok)" stroke-width="2" />
      <text x="170" y="118" font-size="14" fill="var(--ok)" text-anchor="middle">Tallinnas ✓</text>
      <rect x="230" y="96" width="66" height="34" rx="10" fill="none" stroke="var(--line)" />
      <text x="263" y="118" font-size="14" fill="var(--muted)" text-anchor="middle">Tartu</text>
      <rect x="24" y="148" width="272" height="44" rx="10" fill="none" stroke="var(--line)" />
      <text x="40" y="175" font-size="14" font-weight="700" fill="var(--ok)">✓</text>
      <rect x="60" y="163" width="120" height="6" rx="3" fill="var(--line)" />
      <rect x="60" y="175" width="190" height="6" rx="3" fill="var(--line)" />
    </svg>
  </section>

  <PopularTopics lang={lang} />

  <section class="faq-block panel">
    <h2>{s.faqTitle}</h2>
    {s.faq.map(([q, a]) => (
      <details class="faq">
        <summary><h3>{q}</h3></summary>
        <p class="muted">{a}</p>
      </details>
    ))}
  </section>
</Base>

<style>
  .hero { display: grid; gap: 32px; padding-top: 16px; }
  .badge { display: inline-block; padding: 2px 10px; border: 1px solid var(--line); border-radius: 10px; font-size: .875rem; }
  h1 { font-size: clamp(2rem, 5.5vw, 2.8rem); line-height: 1.12; margin: 16px 0; }
  h1 em { font-style: normal; color: var(--accent); }
  .cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .hero-cta { padding: 14px 32px; font-size: 1.15rem; font-weight: 600; margin-top: 8px; }
  .hero-note { margin: 8px 0 0; font-size: .875rem; }
  .hero-links { display: grid; gap: 28px 32px; margin-top: 32px; }
  @media (min-width: 560px) { .hero-links { grid-template-columns: repeat(2, 1fr); } }
  .hero-links a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; }
  .hero-link-label { color: var(--accent); font-size: .95rem; text-decoration: underline; text-underline-offset: 3px; }
  .hero-link-note { font-size: .85rem; }
  .art { max-width: 360px; width: 100%; margin: 0 auto; }
  /* Shared look of the tinted home blocks ("Who it is for", "Check your Estonian"). */
  .panel {
    margin-top: 56px; padding: 32px 24px; border: 1px solid var(--line); border-radius: 20px;
    background: color-mix(in srgb, var(--accent) 7%, var(--card));
  }
  .panel h2 { font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.1; margin: 0 0 12px; }
  .panel h2 em { font-style: normal; color: var(--accent); }
  .audience h2 { margin-bottom: 24px; }
  .aud-grid { display: grid; gap: 12px; }
  @media (min-width: 560px) { .aud-grid { grid-template-columns: repeat(2, 1fr); } }
  .aud { padding: 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); }
  .aud-icon {
    width: 40px; height: 40px; padding: 8px; border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
  }
  .aud h3 { font-size: 1.1rem; margin: 12px 0 6px; }
  .aud p { margin: 0; font-size: .95rem; line-height: 1.5; }
  .promo { display: grid; gap: 24px; align-items: center; }
  .promo p { font-size: 1.1rem; margin: 0 0 16px; max-width: 26em; }
  .promo .badge { margin-bottom: 20px; }
  .promo-art { width: 100%; max-width: 340px; margin: 0 auto; display: block; }
  .faq-block h2 { margin-bottom: 16px; }
  .faq { border-bottom: 1px solid var(--line); }
  .faq:last-child { border-bottom: 0; }
  .faq summary { padding: 14px 0; cursor: pointer; }
  .faq summary h3 { display: inline; font-size: 1.05rem; font-weight: 600; margin: 0; }
  .faq p { margin: 0 0 14px; line-height: 1.5; }
  @media (min-width: 760px) {
    .hero { grid-template-columns: 1.1fr 1fr; align-items: center; }
    .panel { padding: 40px; }
    .promo { grid-template-columns: 1.1fr 1fr; }
  }
</style>
