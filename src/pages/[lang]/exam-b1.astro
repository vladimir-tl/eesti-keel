---
import ExamArticle from '../../components/ExamArticle.astro';
import { langs, type Lang } from '../../i18n/ui';
import { examB1 } from '../../data/exam-b1';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const about = { ru: 'Экзамен B1 по эстонскому языку', en: 'Estonian B1 proficiency exam', et: 'Eesti keele B1-taseme eksam' }[lang];
---
<ExamArticle lang={lang} e={examB1[lang]} slug="exam-b1" testPath="test-b1" topicsPath="topics#b1" about={about} modified="2026-10-02" />
